# NIZIALAND — Environment Variables (Supabase / Production)
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Quando estas variáveis não são preenchidas, a aplicação opera automaticamente
# no modo OFFLINE/LOCAL DATABASE altamente resiliente para laboratórios escolares!
